#include <winres.h>
#include "resource.h"

IDI_VOLUMELIFT ICON "../../assets/VolumeLift.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VolumeLift contributors"
            VALUE "FileDescription", "VolumeLift system-wide volume booster"
            VALUE "FileVersion", "0.1.1"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "VolumeLift.exe"
            VALUE "ProductName", "VolumeLift"
            VALUE "ProductVersion", "0.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
